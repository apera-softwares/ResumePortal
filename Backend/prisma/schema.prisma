generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role
  jobs     Job[]
}

model Job {
  id             Int         @id @default(autoincrement())
  title          String
  description    String
  client         String?
  skills         String[]
  salary         Float
  internalSalary Float?
  location       Location
  type           JobType
  createdById    Int
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  candidates     Candidate[]
  createdBy      User        @relation(fields: [createdById], references: [id])
}

model Candidate {
  id                Int             @id @default(autoincrement())
  firstName         String
  lastName          String
  email             String          @unique
  mobile            String?
  yearsOfExperience Int
  education         String?
  noticePeriod      Int
  resume            String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  resumeText        String?
  cleanedResume     String?
  jobId             Int?
  status            String          @default("Applied")
  resumeJson        String?
  editedHtml        String?
  parsedHtml        String?
  isPublic          Boolean         @default(false)
  job               Job?            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  ResumeVersion     ResumeVersion[]
  skills            Skill[]         @relation("CandidateSkills")
}

model Skill {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  candidates Candidate[] @relation("CandidateSkills")
}

model ResumeVersion {
  id          Int       @id @default(autoincrement())
  candidateId Int
  htmlContent String
  jsonContent String?
  version     Int
  createdAt   DateTime  @default(now())
  Candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

enum Location {
  REMOTE
  MUMBAI
  DELHI
  BANGALORE
  HYDERABAD
  CHENNAI
  PUNE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  FREELANCING
}

enum Role {
  ADMIN
  HR
  CLIENT
  CANDIDATE
}
