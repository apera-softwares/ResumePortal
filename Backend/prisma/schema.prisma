generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  HR
  CLIENT
  CANDIDATE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  FREELANCING
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum CandidateStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs       Job[]
  candidates Candidate[]
}

model Client {
  id          String   @id @default(uuid())
  name        String   @unique
  website     String?
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  jobs        Job[]
}

model Location {
  id   String @id @default(uuid())
  name String @unique
  jobs Job[]
}

model Job {
  id             String          @id @default(uuid())
  title          String
  description    String
  salary         Float
  internalSalary Float?
  locationId     String?
  type           JobType
  status         JobStatus       @default(OPEN)
  clientId       String?
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appliedJobs    AppliedJob[]
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy      User            @relation(fields: [createdById], references: [id])
  location       Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  skills         Skill[]         @relation("JobSkills")
}

model Candidate {
  id                String          @id @default(uuid())
  firstName         String
  lastName          String
  email             String          @unique
  mobile            String?
  yearsOfExperience Int
  education         String?
  noticePeriod      Int
  resume            String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  resumeText        String?
  cleanedResume     String?
  resumeJson        String?
  editedHtml        String?
  parsedHtml        String?
  isPublic          Boolean         @default(false)
  userId            String?
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  appliedJobs       AppliedJob[]
  ResumeVersion     ResumeVersion[]
  skills            Skill[]         @relation("CandidateSkills")
}

model AppliedJob {
  id          String          @id @default(uuid())
  candidateId String
  jobId       String
  status      CandidateStatus @default(APPLIED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
}

model Skill {
  id         String      @id @default(uuid())
  name       String      @unique
  candidates Candidate[] @relation("CandidateSkills")
  jobs       Job[]       @relation("JobSkills")
}

model ResumeVersion {
  id          String    @id @default(uuid())
  candidateId String
  htmlContent String
  jsonContent String?
  version     Int
  createdAt   DateTime  @default(now())
  Candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
